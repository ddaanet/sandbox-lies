#!/usr/bin/env bash
# sandbox-lies-recover: carry out the recovery of a `git checkout <branch>` or
# `git merge --ff-only <commit-ish>` that a sandbox refusal killed part-way.
# Usage in skills/sandbox-lies/references/refused-merge-recovery.md. Without
# --apply it prints the plan and changes nothing; with --apply it runs each act
# as it prints it.
#
#   sandbox-lies-recover [--apply] [-C <dir>] checkout <branch>
#   sandbox-lies-recover [--apply] [-C <dir>] merge <commit-ish>
#
# Exit: 0 nothing left to do, plan carried out, or dry-run printed; 1 the
# re-run or an act failed; 2 usage error or a state it cannot tell.
#
# Residual bound: a working-tree path is compared with a version by content,
# as git stores it, only when it is a regular file. Symlinks, directories and
# other non-regular entries are compared only as presence, and mode-only
# changes are not seen at all. Submodules are compared only as presence too.
#
# bash 3.2, BSD tools: no mapfile, no ${x,,}, no associative arrays. Paths are
# read NUL-delimited, so spaces and newlines in a name are data.

main() {
  APPLY=
  C=.
  ACTS=0
  parse_args "$@"
  top=$(git -C "$C" rev-parse --show-toplevel 2>/dev/null) ||
    usage "not inside a git repository: $C"
  resolve_target
  if reached; then
    REACHED=1
    find_pre || usage "cannot tell where the command stopped: the newest HEAD reflog entry is not the move onto $ARG. Nothing changed."
  else
    REACHED=0
    PRE=$(git -C "$top" rev-parse HEAD)
  fi
  walk_paths
  if [ "$REACHED" -eq 0 ]; then
    rerun
  elif [ "$ACTS" -eq 0 ]; then
    printf 'nothing to do\n'
  fi
  exit 0
}

parse_args() {
  while [ $# -gt 0 ]; do
    case $1 in
      --apply) APPLY=1; shift ;;
      -C) [ $# -ge 2 ] || usage "-C needs a directory"; C=$2; shift 2 ;;
      -*) usage "unknown option: $1" ;;
      *) break ;;
    esac
  done
  [ $# -eq 2 ] || usage
  case $2 in
    ''|-*) usage "missing or invalid ref: '$2'" ;;
  esac
  ARG=$2
  # REFPFX and NOUN resolve the target; CMD is the refused command, printed
  # and re-run from the one array.
  case $1 in
    checkout) SUB=$1; REFPFX=refs/heads/; NOUN=branch; CMD=(checkout "$ARG") ;;
    merge) SUB=$1; REFPFX=; NOUN=commit; CMD=(merge --ff-only "$ARG") ;;
    *) usage "unknown subcommand: $1" ;;
  esac
}

usage() {
  printf 'usage: sandbox-lies-recover [--apply] [-C <dir>] {checkout <branch> | merge <commit-ish>}\n' >&2
  [ $# -eq 0 ] || printf '%s\n' "$1" >&2
  exit 2
}

# TARGET is the commit the refused command was going to reach.
resolve_target() {
  TARGET=$(git -C "$top" rev-parse --verify -q "$REFPFX$ARG^{commit}") ||
    usage "no such $NOUN: $ARG"
}

# Reached: a checkout has switched HEAD to the branch, a merge has moved HEAD
# to the target commit.
reached() {
  if [ "$SUB" = checkout ]; then
    [ "$(git -C "$top" symbolic-ref -q HEAD)" = "refs/heads/$ARG" ]
  else
    [ "$(git -C "$top" rev-parse HEAD)" = "$TARGET" ]
  fi
}

# Sets PRE to the old value of the refused command's move: the newest HEAD
# reflog entry once the same-branch entries a re-run writes are skipped. Any
# other entry above the move (a commit, a reset, another checkout) means the
# move is not the refused command's, and it returns 1. The old value of an
# entry is the new value of the entry after it.
#
# Residual bound: a refused same-branch checkout writes no entry, so with no
# entry since an older move onto the branch, that move is taken for the
# refused one. The dry-run plan, read before --apply, is the guard.
find_pre() {
  local reflog line sha msg want=
  reflog=$(git -C "$top" log -g --format='%H %gs' HEAD) || return 1
  while IFS= read -r line; do
    sha=${line%% *}
    msg=${line#* }
    if [ -n "$want" ]; then
      PRE=$sha
      return 0
    fi
    ! same_branch "$msg" || continue
    moved_onto "$sha" "$msg" || return 1
    want=1
  done <<<"$reflog"
  return 1
}

# Whether a reflog message is a checkout of the branch already checked out.
# Branch names hold no space, so the first " to " splits the two names.
same_branch() {
  local rest
  rest=${1#checkout: moving from }
  [ "$rest" != "$1" ] && [ "${rest%% to *}" = "${rest#* to }" ]
}

# Whether a HEAD reflog entry (new value $1, message $2) is the move the
# refused command made.
moved_onto() {
  if [ "$SUB" = checkout ]; then
    case $2 in
      "checkout: moving from "*" to $ARG") return 0 ;;
    esac
    return 1
  else
    case $2 in
      "merge "*": Fast-forward") [ "$1" = "$TARGET" ] ;;
      *) return 1 ;;
    esac
  fi
}

# Every path the refused command changed, read NUL-delimited. No status filter:
# a path git did not get to may still match neither version and must be kept.
# A path is never empty, so an empty record ends the list and carries git
# diff's exit status, which process substitution would otherwise lose.
walk_paths() {
  local p rc=
  while IFS= read -r -d '' p; do
    if [ -z "$p" ]; then
      IFS= read -r -d '' rc
      break
    fi
    classify "$p"
  done < <(
    git -C "$top" diff --no-renames --name-only -z "$PRE" "$TARGET"
    printf '\0%s\0' "$?"
  )
  [ "$rc" = 0 ] || usage "git diff $PRE $TARGET exited ${rc:-?}: cannot list the paths."
}

# The working copy's version of a path: restore it, remove it, or keep it. A
# directory there (a submodule, or a file/directory swap) is never restored
# or removed: it is compared as presence only, so its content is unknown.
classify() {
  local p=$1
  if same_as HEAD "$p"; then
    return 0
  fi
  if [ -d "$top/$p" ] && [ ! -L "$top/$p" ]; then
    act keep "$p"
  elif same_as "$PRE" "$p" || same_as "$TARGET" "$p"; then
    if has_path HEAD "$p"; then
      act restore "$p"
    else
      act remove "$p"
    fi
  else
    act keep "$p"
  fi
}

# act <restore|remove|keep> <path>: print the act, and carry it out with --apply.
# A path holding a newline or another control character is printed with %q,
# so one act stays one line.
act() {
  case $2 in
    *[[:cntrl:]]*) printf '%s %q\n' "$1" "$2" ;;
    *) printf '%s %s\n' "$1" "$2" ;;
  esac
  [ "$1" != keep ] || return 0
  ACTS=$((ACTS + 1))
  [ -n "$APPLY" ] || return 0
  case $1 in
    restore) git -C "$top" --literal-pathspecs checkout HEAD -- "$2" </dev/null || fail "restore failed: $2" ;;
    remove) rm -f -- "$top/$2" || fail "remove failed: $2" ;;
  esac
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

# Re-run the original command once, when the target was not reached. Its
# refusal is reported and exits 1; it is never replaced by a reset.
rerun() {
  printf 'git %s\n' "${CMD[*]}"
  [ -n "$APPLY" ] || return 0
  git -C "$top" "${CMD[@]}" </dev/null || fail "re-run exited $?"
}

# Working copy state of a path: absent, file (a regular file), or other
# (a symlink, a directory or another non-regular entry).
wstate() {
  if [ -L "$top/$1" ]; then
    echo other
  elif [ -f "$top/$1" ]; then
    echo file
  elif [ -e "$top/$1" ]; then
    echo other
  else
    echo absent
  fi
}

# Whether <rev> has an entry at <path> that is a blob or a submodule commit;
# sets ENTRY_TYPE (blob or commit) and ENTRY_ID. Read from the tree with
# ls-tree, which never dereferences a gitlink, whose commit may be absent from
# this repository. --literal-pathspecs here and on the restore: a name opening
# with `:` is otherwise pathspec magic, which ls-tree dies on and checkout obeys.
has_path() {
  local entry meta
  # One "<mode> <type> <id>\t<path>" record, its NUL dropped; the x keeps a
  # trailing newline in the path from being stripped. Only the entry for
  # this exact path counts.
  entry=$(git -C "$top" --literal-pathspecs ls-tree -z "$1" -- "$2" | tr -d '\0'; printf x)
  entry=${entry%x}
  meta=${entry%%$'\t'*}
  [ "$meta" != "$entry" ] && [ "${entry#*$'\t'}" = "$2" ] || return 1
  ENTRY_TYPE=${meta#* }
  ENTRY_TYPE=${ENTRY_TYPE%% *}
  ENTRY_ID=${meta##* }
  [ "$ENTRY_TYPE" != tree ]
}

# Whether the working copy of <path> matches <rev>'s version: absent where the
# rev has none, for a regular file its blob id as git would store it (eol and
# filter attributes applied, as `git status` compares), presence only for
# anything else.
same_as() {
  local st
  st=$(wstate "$2")
  if has_path "$1" "$2"; then
    case $st in
      absent) return 1 ;;
      file)
        [ "$ENTRY_TYPE" = blob ] || return 1
        [ "$(git -C "$top" hash-object --path="$2" "$top/$2")" = "$ENTRY_ID" ]
        ;;
      *) return 0 ;;
    esac
  else
    [ "$st" = absent ]
  fi
}

main "$@"
