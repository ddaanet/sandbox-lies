#!/usr/bin/env sh
# Dogfood shim (docs/design.md D-16): load this checkout as a plugin, then chain
# to the next `claude` on PATH with this directory stripped from PATH, so the
# next launcher in the chain cannot find the shim again.
unset CDPATH # else `cd` may echo the target, corrupting the capture below
root=$(dirname "$(cd "$(dirname "$0")" && pwd)")
# An entry is dropped when its `claude` is this file (`-ef`), not when its
# spelling matches: a trailing slash or a relative `.bin` would otherwise
# survive and exec the shim again, forever. Explicit `-` operand: BSD paste
# has no implicit stdin, unlike GNU.
# shellcheck disable=SC3013 # -ef: dash, bash, BSD sh and busybox test all have it
PATH=$(printf '%s\n' "$PATH" | tr ':' '\n' | while IFS= read -r dir; do
  [ "$dir/claude" -ef "$0" ] || printf '%s\n' "$dir"
done | paste -sd: -)
export PATH
real=$(command -v claude) || {
  echo "sandbox-lies: no other claude on PATH" >&2
  exit 127
}
exec "$real" --plugin-dir "$root" "$@"
